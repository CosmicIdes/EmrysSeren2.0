                        <p>Hi! All updates will be posted on this page. More to come soon. Updates will include topics like new merchandise, artwork, and collaborations.</p>
                    </article>
                </section>
            </div>
        </div>*@
</main>

@code {
    private int selectedRowNumber = -1;
    private MudTable<BlogUpdate> mudTable;
    private List<string> clickedEvents = new();
    private IEnumerable<BlogUpdate> BlogUpdates = new List<BlogUpdate>()
{
        new BlogUpdate() { User = "EmrysSeren", Date = "July 17, 2024", Title = "First Post", Comments = 0, Tags = "New post" },
        new BlogUpdate() { User = "EmrysSeren", Date = "July 17, 2024", Title = "First Post", Comments = 0, Tags = "New post" }
    };

    private void RowClickEvent(TableRowClickEventArgs<BlogUpdate> tableRowClickEventArgs)
    {
        clickedEvents.Add("Row has been clicked");
    }

    private string SelectedRowClassFunc(BlogUpdate update, int rowNumber)
    {
        if (selectedRowNumber == rowNumber)
        {
            selectedRowNumber = -1;
            clickedEvents.Add("Selected Row: None");
            return string.Empty;
        }
        else if (mudTable.SelectedItem != null && mudTable.SelectedItem.Equals(update))
        {
            selectedRowNumber = rowNumber;
            clickedEvents.Add($"Selected Row: {rowNumber}");
            return "selected";
        }
        else
        {
            return string.Empty;
        }
    }
}
