@page "/updates"
@using MudBlazor
@inject HttpClient httpClient


<PageTitle>Emrys Seren Blog Updates</PageTitle>

<main class="mainUpdates">
    <div class="subHeader">
        <h2>Updates</h2>
    </div>
    <br>
    <MudTable T="BlogUpdate" Items="@BlogUpdates.Take(4)" Hover="true" Breakpoint="Breakpoint.None" @ref="mudTable"
              RowClass="cursor-pointer" RowClassFunc="@SelectedRowClassFunc" OnRowClick="RowClickEvent">
        <HeaderContent>
            <MudTh>User</MudTh>
            <MudTh>Date</MudTh>
            <MudTh>Title</MudTh>
            <MudTh>Comments</MudTh>
            <MudTh>Tags</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="User">@context.User</MudTd>
            <MudTd DataLabel="Date">@context.Date</MudTd>
            <MudTd DataLabel="Title">@context.Title</MudTd>
            <MudTd DataLabel="Comments">"@context.Comments</MudTd>
            <MudTd DataLabel="Tags">@context.Tags</MudTd>

        </RowTemplate>
    </MudTable>

    <MudExpansionPanels Style="flex: 1;">
        <MudExpansionPanel Text="Show inline-clicked event log">
            @foreach (var message in clickedEvents)
            {
                <MudText>@message</MudText>
            }
            @if (clickedEvents.Count > 0)
            {
                <div class="d-flex">
                    <MudSpacer />
                    <MudButton Class="mt-3" ButtonType="ButtonType.Button" Variant="Variant.Filled" OnClick="@(() => clickedEvents.Clear())">Clear events</MudButton>
                </div>
            }
        </MudExpansionPanel>
    </MudExpansionPanels>



    @*<div class="updatePage">
            <div class="updateBox">
                <section class="updateHeader">
                    <h3 class="h3sub">First Update</h3>
                </section>
                <section class="updateTime">
                    <h6>Posted at 1:38pm EST, 18 November 2021</h6>
